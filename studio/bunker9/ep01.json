  "lines": [
    {
      "who": "RADIO",
      "text": "Emergency alert. Missile inbound. Seek shelter now. This is not a drill.",
      "scene": "alert",
      "gap": 0.3,
      "sfx": [
        [
          "siren",
          0.0
        ],
        [
          "vibrate",
          0.1
        ]
      ]
    },
    {
      "who": "MILO",
      "text": "They gave us eleven minutes.",
      "scene": "street_run",
      "gap": 1.0,
      "sfx": [
        [
          "crowd",
          0.0
        ]
      ]
    },
    {
      "who": "HAL",
      "text": "Bunker Nine! This way! Move!",
      "scene": "garage_rush",
      "gap": 0.5,
      "sfx": [
        [
          "crowd",
          0.0
        ]
      ]
    },
    {
      "who": "MAE",
      "text": "Milo! Don't let go!",
      "scene": "separation",
      "gap": 0.6,
      "voice_override": "MAE_LIVE"
    },
    {
      "who": "HAL",
      "text": "We have to seal it! Now!",
      "scene": "door_slam",
      "gap": 0.9,
      "sfx": [
        [
          "slam",
          0.95
        ]
      ]
    },
    {
      "who": "MILO",
      "text": "Then the sky turned white.",
      "scene": "flash",
      "gap": 2.0,
      "sfx": [
        [
          "rumble",
          0.0
        ]
      ]
    },
    {
      "who": "MILO",
      "text": "Six of us made it inside. My sister didn't.",
      "scene": "title_pan",
      "gap": 1.6
    },
    {
      "who": "RADIO",
      "text": "The infected repeat the voices of the people they took. Do not open your doors.",
      "scene": "radio",
      "gap": 0.5,
      "sfx": [
        [
          "static",
          1.3
        ]
      ]
    },
    {
      "who": "JUNE",
      "text": "Four days of food left. Then someone has to go outside.",
      "scene": "june",
      "gap": 0.5
    },
    {
      "who": "MAE",
      "text": "Milo? It's cold. Let me in.",
      "scene": "black_knock",
      "gap": 0.6,
      "sfx": [
        [
          "knock",
          0.0
        ]
      ]
    },
    {
      "who": "MILO",
      "text": "That's Mae. That's my sister!",
      "scene": "run_door",
      "gap": 0.4
    },
    {
      "who": "HAL",
      "text": "Read the door, son.",
      "scene": "rule",
      "gap": 1.1
    },
    {
      "who": "MILO",
      "text": "Never open after dark. They only sound like us.",
      "scene": "rule_read",
      "gap": 0.8
    },
    {
      "who": "DANTE",
      "text": "Then why does she sound so real?",
      "scene": "bolt",
      "gap": 1.0,
      "sfx": [
        [
          "creak",
          0.6
        ]
      ]
    },
    {
      "who": "MAE",
      "text": "I'm wearing my purple dress. The one with the moon on it.",
      "scene": "door_close",
      "gap": 0.9,
      "sfx": [
        [
          "heartbeat",
          0.0
        ]
      ]
    },
    {
      "who": "MILO",
      "text": "That's the dress she wore that night.",
      "scene": "milo_cry",
      "gap": 0.4
    },
    {
      "who": "TEDDY",
      "text": "She isn't cold.",
      "scene": "teddy",
      "gap": 1.4
    },
    {
      "who": "MAE",
      "text": "Milo... hold my hand.",
      "scene": "hand",
      "gap": 3.2,
      "sfx": [
        [
          "knock",
          0.0
        ]
      ],
      "sfx_end": "stinger",
      "sfx_end_at": 2.5
    },
    {
      "who": "NARR",
      "text": "Grab the hand. Slam the slot. Or ask what only Mae would know.",
      "scene": "vote",
      "gap": 2.6
    }
  ]
